<mxfile host="app.diagrams.net"><diagram name="Component Diagram" id="Component-Diagram"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Component Diagram: AI Enabled Ride Booking and Driver Route Recommendation System (browser-based implementation)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1100" height="20" as="geometry"/></mxCell>
<mxCell id="t1" value="Presentation Tier (HTML + CSS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1120" height="120" as="geometry"/></mxCell>
<mxCell id="t2" value="Logic Tier (JavaScript modules)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="1120" height="360" as="geometry"/></mxCell>
<mxCell id="t3" value="Data Tier (Local Storage + JSON)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1120" height="140" as="geometry"/></mxCell>
<mxCell id="pages" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;HTML pages + CSS&lt;/b&gt;&lt;br&gt;Driver, Passenger and Administrator screens (from Figma)" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="100" y="70" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="ui" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;ui.js&lt;/b&gt;&lt;br&gt;shows data, handles clicks with addEventListener" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="rp" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;routePlan.js&lt;/b&gt;&lt;br&gt;define, modify, end route plan and window" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="set" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;settings.js&lt;/b&gt;&lt;br&gt;get and check recommendation settings" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="rr" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;rideRequest.js&lt;/b&gt;&lt;br&gt;submit, validate, cancel, expire requests" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="610" y="220" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="auth" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;auth.js&lt;/b&gt;&lt;br&gt;register, login, role check, 15 min logout" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="eng" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;recommendationEngine.js&lt;/b&gt;&lt;br&gt;filter, detour, fuel cost, profit, rank" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="205" y="330" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="dec" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;decision.js&lt;/b&gt;&lt;br&gt;confirm or reject, timeout, lock request" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="610" y="330" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="aud" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;auditLog.js&lt;/b&gt;&lt;br&gt;record and read-only view of the audit log" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="880" y="330" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="hist" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;rideHistory.js&lt;/b&gt;&lt;br&gt;confirmed rides of a driver" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="adm" value="&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;admin.js&lt;/b&gt;&lt;br&gt;create, update, deactivate users" style="shape=module;jettyWidth=10;jettyHeight=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="220" height="70" as="geometry"/></mxCell>
