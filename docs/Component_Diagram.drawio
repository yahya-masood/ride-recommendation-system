<mxCell id="note" value="All logic modules record events through auditLog.js and check the user role through auth.js. admin.js also uses settings.js. These arrows are not drawn to keep the diagram readable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;spacingLeft=6;size=12;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="240" height="80" as="geometry"/></mxCell>
